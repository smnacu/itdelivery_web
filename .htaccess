# Forzar siempre la carga de index.php al entrar a directorios
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Redireccionar HTTP a HTTPS respetando proxy/Cloudflare
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTPS} off
    RewriteCond %{REQUEST_URI} !^/.well-known/acme-challenge/
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Enrutador Automático de Subdominios a Subcarpetas
    # Bypass de la página de cortesía predeterminada de Ferozo (index.html)
    RewriteCond %{HTTP_HOST} ^almitas\.itdelivery\.com\.ar$ [NC]
    RewriteRule ^(index\.html)?$ /almitas/index.php [L,QSA]

    RewriteCond %{HTTP_HOST} ^almitas\.itdelivery\.com\.ar$ [NC]
    RewriteCond %{REQUEST_URI} !^/almitas/
    RewriteRule ^(.*)$ /almitas/$1 [L,QSA]

    RewriteCond %{HTTP_HOST} ^(?!www\.)([^.]+)\.itdelivery\.com\.ar$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/%1 -d
    RewriteCond %{REQUEST_URI} !^/%1/
    RewriteRule ^(.*)$ /%1/$1 [L,QSA]

    # 3. Prevenir listar directorios por seguridad
    Options -Indexes

    # 4. Bloquear acceso a archivos sensibles
    RedirectMatch 403 /\.(git|env|htaccess)
</IfModule>
