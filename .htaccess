# Forzar siempre la carga de index.php al entrar a directorios
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Redireccionar HTTP a HTTPS respetando proxy/Cloudflare
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTPS} off
    RewriteCond %{REQUEST_URI} !^/.well-known/acme-challenge/
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Enrutador Automático de Subdominios a Subcarpetas
    # ej: almitas.itdelivery.com.ar -> /almitas/
    # ej: peirano.itdelivery.com.ar -> /peirano/
    RewriteCond %{HTTP_HOST} ^(?!www\.)([^.]+)\.itdelivery\.com\.ar$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/%1 -d
    RewriteCond %{REQUEST_URI} !^/%1/
    RewriteRule ^(.*)$ /%1/$1 [L]

    # 3. Prevenir listar directorios por seguridad
    Options -Indexes

    # 4. Bloquear acceso a archivos sensibles
    RedirectMatch 403 /\.(git|env|htaccess)
</IfModule>
